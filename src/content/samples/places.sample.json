      {
        "id": "plc_1091cbd0-25f2-4866-b1c6-2e8b42b68dd6",
        "slug": "coopmart-cong-quynh",
        "category": "activity",
        "name": " Siêu thị Coopmart Cống Quỳnh",
        "englishName": "Coopmart Cong Quynh Supermarket",
        "address": "189C Đ. Cống Quỳnh, Cầu Ông Lãnh, Hồ Chí Minh 700000, Việt Nam",
        "mapsUrl": "https://maps.app.goo.gl/dHH6mJFDFFLbzaNh9",
        "summary": "Co.opmart Cong Quynh is a Vietnamese supermarket where visitors can shop for everyday necessities, local food products, packaged goods, and potential souvenirs. It offers tourists an opportunity to experience a familiar shopping environment used by local residents.",
        "openingHours": {
          "text": "Approximately 7:00 AM–10:00 PM, based on a third-party listing. Confirm directly with the supermarket before visiting.",
          "interpretation": "unparsed"
        },
        "sourceIds": ["src_04910029-f4b5-48bf-bd99-281cd11d56d8"],
        "editorialStatus": "draft",
        "images": [
          {
            "assetId": "img_0db4b9ef0a06ed11f859cce54cbdbd35a960096aded3d9cc4f869ab2b93ed1a3",
            "order": 1,
            "alt": null,
            "caption": null,
            "mapping": "candidate"
          }
        ],
        "coverAssetId": null,
        "activity": {
          "typeText": "Local supermarket, shopping destination, cultural and everyday-life experience",
          "historicalContext": "Co.opmart Cong Quynh opened on February 9, 1996, and was the first supermarket in the Co.opmart chain. It represents an important milestone in the development of modern retail in Ho Chi Minh City.",
          "citySignificance": "A Vietnamese supermarket chain with a wide range of everyday consumer goods and a shopping environment that reflects local purchasing habits.",
          "experiencesText": "Explore Vietnamese packaged foods and snacks, browse local grocery products, purchase practical gifts, compare product prices, and observe everyday shopping practices.Suggested Items to Buy: Packaged Vietnamese snacks, coffee, tea, local condiments, dried foods, and other shelf-stable products, depending on availability.",
          "admissionPrice": {
            "text": "Free",
            "currency": "VND",
            "amount": {
              "kind": "unparsed"
            }
          },
          "suggestedDurationText": "30–60 minutes, late morning or late afternoon to browse local products, purchase souvenirs, and experience everyday supermarket shopping in Vietnam. This is a convenient stop between major attractions and does not require a long visit.",
          "recommendedVisitText": "Late morning or late afternoon, depending on the travel itinerary. Visitors can shop at their convenience and avoid dedicating too much time to this stop.",
          "visitorNotes": "Bring a reusable shopping bag if needed, check product labels and expiry dates, compare prices, and choose packaged goods that are easy to carry. Check airline and customs restrictions before purchasing food products to take overseas.",
          "classification": {
            "status": "reviewed",
            "values": ["culture"]
          },
          "budgetTier": null
        }
      }
