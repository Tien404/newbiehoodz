          "F2": {
            "header": "Giới thiệu ngắn",
            "rawValue": "Co.opmart Cong Quynh is a Vietnamese supermarket where visitors can shop for everyday necessities, local food products, packaged goods, and potential souvenirs. It offers tourists an opportunity to experience a familiar shopping environment used by local residents.",
            "storedType": "s",
            "numberFormat": "0",
            "formula": null,
            "formulaAttributes": null,
            "hyperlinkTargets": []
          },
          "G2": {
            "header": "Ý nghĩa lịch sử/Văn hóa",
            "rawValue": "Co.opmart Cong Quynh opened on February 9, 1996, and was the first supermarket in the Co.opmart chain. It represents an important milestone in the development of modern retail in Ho Chi Minh City.",
            "storedType": "s",
            "numberFormat": "0",
            "formula": null,
            "formulaAttributes": null,
            "hyperlinkTargets": []
          },
          "H2": {
            "header": "Nét đặc trưng của TP.HCM",
            "rawValue": "A Vietnamese supermarket chain with a wide range of everyday consumer goods and a shopping environment that reflects local purchasing habits.",
            "storedType": "s",
            "numberFormat": "0",
            "formula": null,
            "formulaAttributes": null,
            "hyperlinkTargets": []
          },
          "I2": {
            "header": "Điểm nổi bật/Hoạt động nên trải nghiệm",
            "rawValue": "Explore Vietnamese packaged foods and snacks, browse local grocery products, purchase practical gifts, compare product prices, and observe everyday shopping practices.Suggested Items to Buy: Packaged Vietnamese snacks, coffee, tea, local condiments, dried foods, and other shelf-stable products, depending on availability.",
            "storedType": "s",
            "numberFormat": "0",
            "formula": null,
            "formulaAttributes": null,
            "hyperlinkTargets": []
          },
          "J2": {
            "header": "Giờ mở cửa",
            "rawValue": "Approximately 7:00 AM–10:00 PM, based on a third-party listing. Confirm directly with the supermarket before visiting.",
            "storedType": "s",
            "numberFormat": "0",
            "formula": null,
            "formulaAttributes": null,
            "hyperlinkTargets": []
          },
          "K2": {
            "header": "Giá vé (VNĐ)",
            "rawValue": "Free",
            "storedType": "s",
            "numberFormat": "0",
            "formula": null,
            "formulaAttributes": null,
            "hyperlinkTargets": []
          },
          "L2": {
            "header": "Thời lượng tham quan gợi ý",
            "rawValue": "30–60 minutes, late morning or late afternoon to browse local products, purchase souvenirs, and experience everyday supermarket shopping in Vietnam. This is a convenient stop between major attractions and does not require a long visit.",
            "storedType": "s",
            "numberFormat": "0",
            "formula": null,
            "formulaAttributes": null,
            "hyperlinkTargets": []
          },
          "M2": {
            "header": "Thời điểm nên đến",
            "rawValue": "Late morning or late afternoon, depending on the travel itinerary. Visitors can shop at their convenience and avoid dedicating too much time to this stop.",
            "storedType": "s",
            "numberFormat": "0",
            "formula": null,
            "formulaAttributes": null,
            "hyperlinkTargets": []
          },
          "N2": {
            "header": "Lưu ý khi tham quan",
            "rawValue": "Bring a reusable shopping bag if needed, check product labels and expiry dates, compare prices, and choose packaged goods that are easy to carry. Check airline and customs restrictions before purchasing food products to take overseas.",
            "storedType": "s",
            "numberFormat": "0",
